{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "x07.studio.review_round@0.1.0",
  "title": "ReviewRound",
  "type": "object",
  "required": ["schema_version", "session_id", "round", "reviewer", "verdict", "concerns", "created_at"],
  "properties": {
    "schema_version": { "const": "x07.studio.review_round@0.1.0" },
    "session_id": { "type": "string" },
    "round": { "type": "integer", "minimum": 1 },
    "reviewer": { "type": "string" },
    "verdict": { "enum": ["accept", "revise", "block"] },
    "concerns": { "type": "array", "items": { "type": "object" } },
    "created_at": { "type": "string" }
  },
  "additionalProperties": false
}
